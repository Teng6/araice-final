                    }
                }
            ]
        },
        {
            "name": "Admin list alerts",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/alerts",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "alerts"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('admin sees seeded outbreak alert', function () { pm.response.to.have.status(200); pm.expect((pm.response.json().data || []).some(function (alert) { return alert.id == pm.collectionVariables.get('farmerAlertId'); })).to.eql(true); });"
                        ]
                    }
                }
            ]
        }
    ]
